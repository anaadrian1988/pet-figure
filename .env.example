# fal.ai
FAL_KEY=
# Image-edit model (FLUX.3 Klein). About $0.009 per 896x1152 image.
FAL_MODEL_ID=blackforestlabs/flux-3/klein/edit-image

# Supabase (service role key is server-only; never expose it to the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PREVIEW_BUCKET=previews
SUPABASE_HD_BUCKET=hd

# Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
DAILY_GENERATION_LIMIT=2
# Abuse guard: site-wide previews per day = this base + EXTRA_PREVIEWS_PER_SALE for each sale that day.
# Real demand raises it automatically; it only stops previews that come with no sales.
DAILY_GLOBAL_GENERATION_LIMIT=300
EXTRA_PREVIEWS_PER_SALE=100
IP_HASH_SALT=change-me

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Unlock price in cents (499 = 4.99). Drives both the price shown and the amount charged.
STRIPE_UNIT_AMOUNT=499
STRIPE_CURRENCY=usd

# Site address, used to send buyers back after checkout (server-only)
SITE_URL=http://localhost:3000

# Resend (emails buyers their download link after payment). Leave empty to skip emails.
RESEND_API_KEY=
# Sender, e.g. "PetFigure <figures@yourdomain.com>". Until your domain is verified in Resend,
# use "PetFigure <onboarding@resend.dev>", which can only email your own Resend account address.
EMAIL_FROM=
# Optional: where customer replies go, e.g. support@yourdomain.com
EMAIL_REPLY_TO=

# Owner alerts: daily-cap warnings (80% / 100%) and the morning summary go here.
# With Resend's test sender this must be the email address of your Resend account.
ALERT_EMAIL=
# Protects the daily summary job; Vercel Cron sends it automatically. Any long random string.
CRON_SECRET=
