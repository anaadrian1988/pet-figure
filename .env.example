# fal.ai
FAL_KEY=
# Image-edit model (FLUX.3 Klein). About $0.009 per 896x1152 image.
FAL_MODEL_ID=blackforestlabs/flux-3/klein/edit-image

# Supabase (service role key is server-only; never expose it to the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PREVIEW_BUCKET=previews
SUPABASE_HD_BUCKET=hd

# Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
DAILY_GENERATION_LIMIT=2
IP_HASH_SALT=change-me

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Either a Price ID from the Stripe dashboard...
STRIPE_PRICE_ID=
# ...or leave it empty and use an inline price (amount in cents)
STRIPE_UNIT_AMOUNT=499
STRIPE_CURRENCY=usd

# Public site URL, used for the post-checkout redirect
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_PRICE_LABEL=$4.99
