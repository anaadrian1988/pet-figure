# fal.ai
FAL_KEY=
# Image-edit model (FLUX.3 Klein). About $0.009 per 896x1152 image.
FAL_MODEL_ID=blackforestlabs/flux-3/klein/edit-image

# Supabase (service role key is server-only; never expose it to the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PREVIEW_BUCKET=previews
SUPABASE_HD_BUCKET=hd

# Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
DAILY_GENERATION_LIMIT=2
IP_HASH_SALT=change-me

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Unlock price in cents (499 = 4.99). Drives both the price shown and the amount charged.
STRIPE_UNIT_AMOUNT=499
STRIPE_CURRENCY=usd

# Site address, used to send buyers back after checkout (server-only)
SITE_URL=http://localhost:3000
