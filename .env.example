# fal.ai
FAL_KEY=
# Model used for the edit. Defaults to fal-ai/flux-3/klein/edit.
# The @fal-ai/client typings list blackforestlabs/flux-3/klein/edit-image instead.
FAL_MODEL_ID=fal-ai/flux-3/klein/edit

# Supabase (service role key is server-only; never expose it to the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PREVIEW_BUCKET=previews
SUPABASE_HD_BUCKET=hd

# Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
DAILY_GENERATION_LIMIT=2
IP_HASH_SALT=change-me

# Lemon Squeezy
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=

# Public site URL, used for the post-checkout redirect
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_PRICE_LABEL=$4.99
